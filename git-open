#!/usr/bin/env bash
# Open a remote branch or file in the default browser.
set -eu

fail() {
  echo "git-open: $*" >&2
  exit 1
}

encode_path() {
  local LC_ALL=C value=$1 char i
  for ((i = 0; i < ${#value}; i++)); do
    char=${value:i:1}
    case $char in
      [a-zA-Z0-9.~_/-]) printf '%s' "$char" ;;
      *) printf '%%%02X' "'$char" ;;
    esac
  done
}

if [[ ${1-} == --help || ${1-} == -h ]]; then
  echo 'Usage: git open [branch [file_path]]'
  exit 0
fi
[[ $# -le 2 ]] || fail 'Usage: git open [branch [file_path]]'

git rev-parse --git-dir >/dev/null 2>&1 || fail 'This is not a git repository'
remote=$(git config --get remote.origin.url) || fail 'There is no origin remote'
[[ -n $remote ]] || fail 'The origin remote URL is empty'

# Accept HTTP(S), SSH URLs, and Git’s scp-style SSH syntax.
scheme=https
case $remote in
  http://*|https://*|ssh://*)
    transport=${remote%%://*}
    address=${remote#*://}
    [[ $address == */* ]] || fail "Invalid remote URL: $remote"
    authority=${address%%/*}
    host=${authority##*@}
    repo=${address#*/}
    if [[ $transport == ssh ]]; then
      host=${host%%:*}
    else
      scheme=$transport
    fi
    ;;
  *:*)
    host=${remote%%:*}
    host=${host##*@}
    repo=${remote#*:}
    ;;
  *) fail "Unsupported remote URL: $remote" ;;
esac
repo=${repo%/}
repo=${repo%.git}
[[ -n $host && $repo == */* ]] || fail "Invalid remote URL: $remote"

case ${host%%:*} in
  github.com|github.*) provider=github ;;
  bitbucket.org) provider=bitbucket ;;
  gitlab.com|gitlab.*) provider=gitlab ;;
  codeberg.org) provider=codeberg ;;
  *) fail "Unsupported Git host: $host" ;;
esac

if [[ $# -gt 0 ]]; then
  branch=$1
else
  branch=$(git symbolic-ref --quiet --short HEAD) || fail 'Detached HEAD; specify a branch explicitly'
fi
git check-ref-format "refs/heads/$branch" >/dev/null 2>&1 || fail "Invalid branch name: $branch"
git show-ref --verify --quiet "refs/remotes/origin/$branch" ||
  fail "Branch '$branch' is not in the local origin refs; try git fetch origin"

kind=tree
[[ $# -lt 2 ]] || kind=blob
case $provider in
  github) route=$kind ;;
  gitlab) route=-/$kind ;;
  bitbucket)
    route=branch
    [[ $kind == tree ]] || route=src
    ;;
  codeberg) route=src/branch ;;
esac

url="$scheme://$host/$repo/$route/$(encode_path "$branch")"
if [[ $# -eq 2 ]]; then
  file=${2#./}
  [[ -n $file && $file != /* ]] || fail 'File path must be nonempty and repository-relative'
  url="$url/$(encode_path "$file")"
fi

case $OSTYPE in
  darwin*) opener=open ;;
  linux*) opener=xdg-open ;;
  *) fail "Unsupported operating system: $OSTYPE" ;;
esac
command -v "$opener" >/dev/null 2>&1 || fail "Required browser opener not found: $opener"
echo "Opening: $url"
"$opener" "$url" || fail "Could not open URL with $opener"
